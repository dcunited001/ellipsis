#!/usr/bin/env bash
echo 'stopping portals in this order: gtk, hyprland, xkg...'
systemctl --user stop xdg-desktop-portal-gtk
systemctl --user stop xdg-desktop-portal-hyprland
systemctl --user stop xdg-desktop-portal

sleep 1
echo 'starting portals in this order: xdg-desktop-portal...'
systemctl --user start xdg-desktop-portal

echo 'done. d-bus activation should start xdg-desktop-portal-{hyprland,gtk}'
