# -*- mode: bash-ts -*-
pkgname=ctre-corvus-bin
pkgdesc="CLI Utility to generate mechanisms"
# _binname=${pkgname%ctre-}
_binname=corvus
provides=("ctre-corvus")

pkgrel=1
arch=('x86_64' 'aarch64')
license=('None') # can't easily find this
url="https://docs.ctr-electronics.com/cli-tools"

pkgver="26.70.0"
source_x86_64=("https://redist.ctr-electronics.com/tools/corvus/26.70.0/corvus-26.70.0-linuxx86-64")
sha1sums_x86_64=("0937520c50d1ae3c4b471e29c82d24d9c1ce813e")
source_aarch64=("https://redist.ctr-electronics.com/tools/corvus/26.70.0/corvus-26.70.0-linuxarm64")
sha1sums_aarch64=("ec3df7cf0aa090ee5bfe31dc56bd3cabb8e2564d")

depends=()
noextract=(
    ${source_x86_64[@]}
    ${source_aarch64[@]}
)

package() {
    cd "$srcdir"
    case "$arch" in
       x86_64) _binfile="${_binname}-${pkgver}-linuxx86-64" ;;
       aarch64) _binfile="${_binname}-${pkgver}-linuxarm64" ;;
    esac
    mv "${_binfile}" "${_binname}"
    # TODO: ln -sf "${_binfile}" "${_binname}" and move both?
    install -Dm0755 -t "$pkgdir/usr/bin" "$srcdir/${_binname}"
}
